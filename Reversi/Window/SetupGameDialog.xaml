<Window x:Class="Reversi.SetupGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reversi"
        mc:Ignorable="d"
        Title="SetupGameDialog" Background="DimGray" Height="500" Width="500" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="40" Background="Black" Foreground="White" Height="60" BorderBrush="Black" BorderThickness="1">CHOOSE GAMEMODE</Label>
        <Button BorderBrush="Black" BorderThickness="2" Grid.Row="1" Height="60" Width="350" FontSize="30" Click="HVHOptionPicked" Content="HUMAN VS HUMAN"/>
        <Button BorderBrush="Black" BorderThickness="2" Grid.Row="2" Height="60" Width="350" FontSize="30" Click="HVCOptionPicked" Content="HUMAN VS CPU"/>
        <Button BorderBrush="Black" BorderThickness="2" Grid.Row="3" Height="60" Width="350" FontSize="30" Click="CVCOptionPicked" Content="CPU VS CPU"/>
    </Grid>
</Window>