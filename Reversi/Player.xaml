<Window x:Class="Reversi.Player"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Reversi"
        mc:Ignorable="d"
        Title="Player Selection" Height="Auto" Width="200">
    <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Label BorderBrush="Black" BorderThickness="1" Margin="2" HorizontalAlignment="Center">Human or CPU?</Label>
            <Button BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="0" Name="Human" Margin="2" Click="OnClickHuman" ClickMode="Press">Human</Button>
            <Button BorderBrush="Black" BorderThickness="1" Grid.Row="2" Grid.Column="1" Name="CPU" Margin="2" Click="OnClickCPU" ClickMode="Press">CPU</Button>
        </Grid>
</Window>
